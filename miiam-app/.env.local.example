# =============================================================================
# MIIAM Super App — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env or .env.local to version control.
# =============================================================================

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Security (Required) ---
HMAC_SECRET=your-64-char-random-secret-for-hmac-signing

# --- Cron/Webhook Auth (Required for automated endpoints) ---
CRON_SECRET=your-64-char-random-secret-for-cron-auth

# --- Database (Prisma — for local migrations) ---
DATABASE_URL=postgresql://user:password@host:5432/miiam

# --- SMS Provider (Choose one) ---
# Fast2SMS (India):
SMS_API_URL=https://www.fast2sms.com/dev/walletApi
SMS_API_KEY=demo_key_placeholder

# Msg91 alternative:
# SMS_API_URL=https://api.msg91.com/api/v5/otp
# SMS_API_KEY=YOUR_MSG91_API_KEY

# Twilio alternative:
# SMS_API_URL=https://api.twilio.com/2010-04-01/Accounts/YOUR_ACCOUNT_SID/Messages.json
# SMS_API_KEY=YOUR_TWILIO_AUTH_TOKEN

# --- Email (Resend) ---
RESEND_API_KEY=re_example_key

# --- Analytics ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Push Notifications ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# --- App URL (for API callbacks like email links) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Service Worker ---
NEXT_PUBLIC_ENABLE_SW=true

# --- Razorpay (Payment Gateway — Required for online payments) ---
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- WhatsApp (optional) ---
# WhatsApp Cloud API — get from https://developers.facebook.com/apps/
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
NEXT_PUBLIC_WHATSAPP_ACCESS_TOKEN=your-access-token

# --- Upstash Redis (Required for persistent rate limiting) ---
# Get from https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Sentry (Error Monitoring) ---
# Get DSN from https://sentry.io → Settings → Projects → Client Keys
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
