{
  "crons": [
    {
      "path": "/api/printing/cleanup",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/orders/activate-scheduled",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/orders/check-expired",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/recurring-schedules/process",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/chunks/(.*).js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/icons/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "image/svg+xml" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
